cal Problems\n\n1. [Problem Name]  \n**Issue:** [Clear explanation]  \n**Example from CV:** \"[Exact quote]\"  \n**Fix:** \"[Copy-paste replacement]\"\n\n2. [Problem Name]  \n**Issue:**  \n**Example from CV:**  \n**Fix:**  \n\n[Max 4 problems — highest impact first]\n\n---\n\n🔑 Missing Keywords\n- [Keyword] → [Where to add it]\n- [Max 5]\n\n---\n\n✏️ Before → After\n\nSummary:\n\n**Before:**  \n\"[Exact text]\"\n\n**After:**  \n\"[Improved version — max 3 lines]\"\n\n---\n\n[Weakest Section]\n\n**Before:**  \n\"[Exact text]\"\n\n**After:**  \n\"[Improved version with metrics]\"\n\n---\n\n📋 Quick Wins\n- [ ] [2-min fix]\n- [ ] [5-min fix]\n- [ ] [10-min fix]\n\n---\n\n## 🎯 Final Verdict\n[2 short sentences: biggest issue + next step]\n\n===================\nRULES\n===================\n- Use exact quotes from CV\n- Give copy-paste fixes\n- No generic advice\n- No extra sections\n- Keep concise\n\n===================\nLANGUAGE\n===================\nIf Language = \"ar\" → Arabic  \nIf Language = \"en\" → English"}},"type":"@n8n/n8n-nodes-langchain.agent","typeVersion":3.1,"position":[-1792,-1136],"id":"5f8d0ea8-bebd-4445-8576-c18189da1cfe","name":"CV analysis"},{"parameters":{"content":"# AI Layer","height":432,"width":336,"color":4},"type":"n8n-nodes-base.stickyNote","position":[-1872,-1264],"typeVersion":1,"id":"b68cb628-7c0d-4474-8402-bf70bd87f179","name":"Sticky Note1"},{"parameters":{"content":"# AI Layer","height":432,"width":320,"color":4},"type":"n8n-nodes-base.stickyNote","position":[-2480,-1264],"typeVersion":1,"id":"9b88576a-551f-423f-866a-d88fc2dc0c5b","name":"Sticky Note2"},{"parameters":{"content":"# Output","height":432,"width":480},"type":"n8n-nodes-base.stickyNote","position":[-1520,-1264],"typeVersion":1,"id":"5b02eef2-634b-4117-b06b-c23dbd5b2534","name":"Sticky Note5"},{"parameters":{"content":"# Output","height":432},"type":"n8n-nodes-base.stickyNote","position":[-2144,-1264],"typeVersion":1,"id":"5a726fcd-b992-4a8c-a40d-0d834716cca0","name":"Sticky Note6"},{"parameters":{"content":"# Data Laye\n","height":736,"width":336,"color":6},"type":"n8n-nodes-base.stickyNote","position":[-2832,-1568],"typeVersion":1,"id":"aa69160b-c66e-45f0-a597-2549b7b9211d","name":"Sticky Note7"},{"parameters":{"content":"# Input","height":992,"width":736,"color":7},"type":"n8n-nodes-base.stickyNote","position":[-3584,-1824],"typeVersion":1,"id":"14aa5474-3494-414b-9d8d-299ac2b5d019","name":"Sticky Note4"},{"parameters":{"content":"# Processing\n","height":288,"width":800,"color":3},"type":"n8n-nodes-base.stickyNote","position":[-2480,-1568],"typeVersion":1,"id":"798f5213-2eb7-44b2-841b-4c893c72d30a","name":"Sticky Note3"},{"parameters":{"jsCode":"// Clean extracted CV text\nconst item = $input.item;\nlet rawText = item.json.text || item.json.data || '';\n\nif (!rawText || rawText.trim().length < 100) {\n  throw new Error('Could not extract text from CV. File may be scanned or corrupted.');\n}\n\n// Clean text\nlet cleaned = rawText\n  .replace(/\\\\n/g, '\\n')\n  .replace(/[\\u00A0\\u200B\\u200C\\u200D\\uFEFF]/g, ' ')\n  .replace(/ {2,}/g, ' ')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\n// Smart limit to reduce AI cost\nconst maxLength = 3500;\n\nlet limitedText = cleaned;\n\nif (cleaned.length > maxLength) {\n  limitedText =\n    cleaned.slice(0, 2500) +\n    '\\n...\\n' +\n    cleaned.slice(-1000);\n}\n\n// Metadata\nconst meta = $('Validate File').first().json;\n\n// Language fallback\nconst language =\n  meta.language ||\n  item.json.language ||\n  (cleaned.match(/[ء-ي]/) ? 'ar' : 'en');\n\nreturn [{\n  json: {\n    cvText: limitedText,\n    fullCvText: cleaned,\n    chatId: meta.chatId,\n    userId: meta.userId,\n    userName: meta.userName,\n    fileType: meta.fileType,\n    fileName: meta.fileName,\n    language,\n    wordCount: cleaned.split(/\\s+/).length\n  }\n}];"},"id":"0c201762-b3c8-4524-8922-c54cc0d9d0e9","name":"Clean Text","type":"n8n-nodes-base.code","typeVersion":2,"position":[-1856,-1472]},{"parameters":{"operation":"docx"},"id":"3e7e84bb-3e41-49b6-ae40-8f81373d804e","name":"Extract DOCX","type":"n8n-nodes-base.extractFromFile","typeVersion":1,"position":[-2032,-1408]},{"parameters":{"operation":"pdf","binaryPropertyName":"={{ $json.fileKey }}","options":{}},"id":"fb70c677-c212-47af-ab64-b1ade5903b60","name":"Extract PDF","type":"n8n-nodes-base.extractFromFile","typeVersion":1,"position":[-2032,-1568]},{"parameters":{"rules":{"values":[{"conditions":{"string":[{"value1":"={{ $json.fileType }}","value2":"pdf"}],"combinator":"and","options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":1}},"renameOutput":true,"outputKey":"PDF"},{"conditions":{"string":[{"value1":"={{ $json.fileType }}","value2":"docx"}],"combinator":"and","options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":1}},"renameOutput":true,"outputKey":"DOCX"}]},"options":{}},"id":"0b05cfad-8157-4fbf-9763-bddc5c183d58","name":"Route by Type","type":"n8n-nodes-base.switch","typeVersion":3,"position":[-2176,-1488]},{"parameters":{"conditions":{"boolean":[{"value1":"={{ $json.error }}","value2":true}]}},"id":"27a63203-e764-40bb-b7f7-c54ecabfe77e","name":"Has Error?","type":"n8n-nodes-base.if","typeVersion":1,"position":[-2336,-1488]},{"parameters":{"jsCode":"// Validate file type\nconst telegram = $('Telegram Trigger1').first().json;\nconst files = $('Telegram Trigger1').first().binary || {};\n\nconst doc = telegram.message?.document;\n\nlet language = 'en';\n\ntry {\n  language = $('Get User Language').first().json.language || 'en';\n} catch (e) {\n  language = 'en';\n}\n\nif (!doc) {\n  return [{\n    json: {\n      error: true,\n      chatId: telegram.message.chat.id,\n      userId: telegram.message.from.id,\n      language,\n      errorMessage: language === 'ar'\n        ? 'لم يتم العثور على ملف. الرجاء إرسال CV بصيغة PDF أو DOCX.'\n        : 'No document found. Please upload a PDF or DOCX CV.'\n    }\n  }];\n}\n\nconst fileName = (doc.file_name || '').toLowerCase();\nconst mime = (doc.mime_type || '').toLowerCase();\n\nconst isPdf = fileName.endsWith('.pdf') || mime.includes('pdf');\nconst isDocx = fileName.endsWith('.docx') || mime.includes('wordprocessingml');\n\nif (!isPdf && !isDocx) {\n  return [{\n    json: {\n      error: true,\n      chatId: telegram.message.chat.id,\n      userId: telegram.message.from.id,\n      language,\n      errorMessage: language === 'ar'\n        ? 'نوع الملف غير مدعوم. الرجاء إرسال PDF أو DOCX فقط.'\n        : 'Unsupported file type. PDF or DOCX only.'\n    }\n  }];\n}\n\nconst fileKey = Object.keys(files)[0];\n\nreturn [{\n  json: {\n    error: false,\n    chatId: telegram.message.chat.id,\n    userId: telegram.message.from.id,\n    userName: telegram.message.from.first_name || 'User',\n    fileType: isPdf ? 'pdf' : 'docx',\n    fileName: doc.file_name,\n    fileKey,\n    language\n  },\n  binary: files\n}];"},"id":"ebbac50a-524d-462f-9301-530b2ca23969","name":"Validate File","type":"n8n-nodes-base.code","typeVersion":2,"position":[-2464,-1488]}],"connections":{"Store Language":{"main":[[{"node":"Save Language to Google Sheets","type":"main","index":0}]]},"Is /start?":{"main":[[{"node":"Send Language Buttons1","type":"main","index":0}],[{"node":"Has Document?","type":"main","index":0}]]},"Has Document?":{"main":[[{"node":"Get User Language","type":"main","index":0}],[{"node":"Get User Data","type":"main","index":0}]]},"Telegram Trigger1":{"main":[[{"node":"Is Callback?1","type":"main","index":0}]]},"Is Callback?1":{"main":[[{"node":"Store Language","type":"main","index":0}],[{"node":"Is /start?","type":"main","index":0}]]},"Save Language to Google Sheets":{"main":[[{"node":"Send Upload Instructions","type":"main","index":0}]]},"Get User Data":{"main":[[{"node":"If","type":"main","index":0}]]},"Follow Up":{"main":[[{"node":"Send Report1","type":"main","index":0}]]},"OpenAI Chat Model1":{"ai_languageModel":[[{"node":"Follow Up","type":"ai_languageModel","index":0}]]},"If":{"main":[[{"n