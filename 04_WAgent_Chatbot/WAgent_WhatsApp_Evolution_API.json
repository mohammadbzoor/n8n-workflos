ide*/ $fromAI('After', ``, 'string') }}","timeMax":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Before', ``, 'string') }}","options":{}},"type":"n8n-nodes-base.googleCalendarTool","typeVersion":1.3,"position":[2896,1056],"id":"c3b134ba-00cb-4083-871f-2e6406a06cb5","name":"Get Many Events","credentials":{"googleCalendarOAuth2Api":{"id":"BV42O20VsGUeSOhj","name":"Google Calendar account"}}},{"parameters":{"operation":"update","calendar":{"__rl":true,"value":"your-email@example.com","mode":"list","cachedResultName":"your-email@example.com"},"eventId":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Event_ID', ``, 'string') }}","updateFields":{}},"type":"n8n-nodes-base.googleCalendarTool","typeVersion":1.3,"position":[3040,1056],"id":"a1422fb2-1a43-47a6-a3e7-ad87003873e8","name":"Update Events","credentials":{"googleCalendarOAuth2Api":{"id":"BV42O20VsGUeSOhj","name":"Google Calendar account"}}},{"parameters":{"sendTo":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('To', ``, 'string') }}","subject":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Subject', ``, 'string') }}","emailType":"text","message":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Message', ``, 'string') }}","options":{"appendAttribution":false}},"type":"n8n-nodes-base.gmailTool","typeVersion":2.1,"position":[1232,1088],"id":"03dfef31-6ed2-4e4d-a191-824b162f3d42","name":"Send a message","webhookId":"007ef44f-18fb-4fb0-b9bb-c39302708160","credentials":{"gmailOAuth2":{"id":"3QVkcar4bRSJfCkZ","name":"Gmail account"}}},{"parameters":{"operation":"getAll","returnAll":"={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Return_All', ``, 'boolean') }}","limit":5,"simple":false,"filters":{},"options":{}},"type":"n8n-nodes-base.gmailTool","typeVersion":2.1,"position":[1520,1088],"id":"7946bc9a-9a16-42ad-9af8-ab86747e6b38","name":"Get many e-mails","webhookId":"ab24367e-b1f5-4307-9721-1b27b53f6b1f","credentials":{"gmailOAuth2":{"id":"3QVkcar4bRSJfCkZ","name":"Gmail account"}}},{"paramet